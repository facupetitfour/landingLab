generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                 String    @id
  email              String    @unique
  fullName           String?   @map("full_name")
  avatarUrl          String?   @map("avatar_url")
  createdAt          DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime? @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  credits            Int       @default(0)
  isSubscribed       Boolean   @default(false) @map("is_subscribed")
  mpSubscriptionId   String?   @map("mp_subscription_id")
  subscriptionStatus String?   @map("subscription_status")

  projects Project[]
  payments Payment[]

  @@map("profiles")
}

model Project {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id")
  name                 String    @default("Mi landing page")
  status               String    @default("welcome")
  briefData            Json      @default("{}") @map("brief_data")
  strategyData         Json      @default("{}") @map("strategy_data")
  archetype            String?
  skeletonType         String    @default("standard_infoproduct") @map("skeleton_type")
  activeVersion        Int       @default(0) @map("active_version")
  currentQuestionIndex Int       @default(0) @map("current_question_index")
  createdAt            DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt            DateTime? @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  profile        Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessages   ChatMessage[]
  projectOutputs ProjectOutput[]

  @@index([userId], map: "idx_projects_user_id")
  @@map("projects")
}

model ChatMessage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  role      String
  content   String
  metadata  Json?     @default("{}")
  createdAt DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "idx_chat_messages_project_id")
  @@map("chat_messages")
}

model ProjectOutput {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  version     Int
  copyData    Json      @map("copy_data")
  htmlContent String    @map("html_content")
  createdAt   DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId], map: "idx_project_outputs_project_id")
  @@map("project_outputs")
}

model Skeleton {
  id           String    @id
  name         String
  description  String?
  htmlTemplate String    @map("html_template")
  version      Int       @default(1)
  createdAt    DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")

  @@map("skeletons")
}

model Payment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id")
  mpId      String    @unique @map("mp_id")
  status    String
  createdAt DateTime? @default(now()) @db.Timestamptz(6) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_payments_user_id")
  @@map("payments")
}
